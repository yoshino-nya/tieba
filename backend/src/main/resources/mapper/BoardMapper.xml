<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.tieba.mapper.BoardMapper">
    <resultMap id="boardDetailResponse" type="org.example.tieba.dto.BoardDetailResponse" autoMapping="true">
        <id property="id" column="id"/>
        <association property="manager" javaType="org.example.tieba.dto.UserBrief">
            <id property="id" column="manager_id"/>
            <result property="username" column="manager_username"/>
            <result property="nickname" column="manager_nickname"/>
            <result property="avatar" column="manager_avatar"/>
        </association>
    </resultMap>

    <select id="selectDetailById" resultMap="boardDetailResponse">
        SELECT b.id, b.name, b.description, b.created_at,
        u.id AS manager_id,
        u.username AS manager_username,
        u.nickname AS manager_nickname,
        u.avatar AS manager_avatar,
        (
        SELECT COUNT(*) FROM board_members bm
        WHERE bm.board_id = b.id
        ) AS member_count,
        (
        SELECT COUNT(*) FROM post p
        WHERE p.board_id = b.id
        ) AS post_count
        FROM boards b
        JOIN users u ON u.id = b.manager_id
        WHERE b.id = #{id}
    </select>
</mapper>