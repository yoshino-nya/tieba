<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.tieba.comment.CommentMapper">

    <resultMap id="commentResponse" type="org.example.tieba.comment.CommentResponse" autoMapping="true">
        <id property="id" column="id"/>
        <association property="userBrief" javaType="org.example.tieba.common.dto.UserBrief">
            <id property="id" column="user_id"/>
            <result property="username" column="user_username"/>
            <result property="nickname" column="user_nickname"/>
            <result property="avatar" column="user_avatar"/>
        </association>
    </resultMap>
    <select id="selectByPostId" resultMap="commentResponse">
        select
            c.id, c.content, c.post_id, c.root_id, c.parent_id, c.created_at,
            u.id as user_id,
            u.username as user_username,
            u.nickname as user_nickname,
            u.avatar as user_avatar
        from comment c
        join users u on c.user_id = u.id
        where c.post_id = #{postId} and c.status = 0
        order by c.created_at
    </select>

</mapper>